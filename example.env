# ============================================================
# AI Platform — Environment Configuration (.env.example)
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ============================================================

# ── OpenAI / LLM ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ── FileNest (internal SDK — external file service) ─────────
# Get these from the FileNest dashboard / your team.
FILENEST_API_KEY=fn_your_filenest_api_key
FILENEST_PROJECT_ID=your-project-uuid
FILENEST_API_URL=https://filenest.drgodly.com

# ── PostgreSQL (filenest_files table + staging) ─────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filenest

# ── ArangoDB (cloud — Oasis) ────────────────────────────────
ARANGO_HOST=https://your-instance.arangodb.cloud:8529
ARANGO_PORT=8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=change-me
ARANGO_DATABASE=medical_graph

# ── Neo4j (local Docker) ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ============================================================
# Airflow
# ============================================================
# Airflow runs from its OWN venv (e.g. /home/kipla/airflow/venv),
# separate from this project's uv .venv.
#
# The DAGs (dags/unstructure/filenest/*) load this same .env via
# python-dotenv, so the FILENEST_* and POSTGRES_* values above
# are used by Airflow too — no need to duplicate them.
#
# Airflow itself needs these packages in ITS venv:
#   /home/kipla/airflow/venv/bin/pip install apache-airflow==3.1.5
#   /home/kipla/airflow/venv/bin/pip install "apache-airflow-providers-standard"
#   /home/kipla/airflow/venv/bin/pip install" apache-airflow-providers-http"
#   /home/kipla/airflow/venv/bin/pip install "apache-airflow-providers-postgres"
#   /home/kipla/airflow/venv/bin/pip install -e /home/kipla/filenest-python-sdk
#   /home/kipla/airflow/venv/bin/pip install psycopg2-binary sqlalchemy pydantic python-dotenv
# ============================================================
